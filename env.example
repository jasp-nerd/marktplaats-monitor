# Marktplaats Item Monitor Configuration
# Copy this file to .env and fill in your values
# The application will automatically load these settings - no need to export!

# Required: Discord webhook URL for notifications
# Get this from Discord: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Required: Marktplaats search URL for the items you want to monitor
# Go to Marktplaats.nl, search for your item with filters, then copy the URL.
# Location filters in the URL fragment (#postcode:...) are honored.
# Examples:
# SEARCH_URL=https://www.marktplaats.nl/q/apple+tv+4k/
# SEARCH_URL=https://www.marktplaats.nl/q/iphone/
# SEARCH_URL=https://www.marktplaats.nl/q/apple+homepod+mini/#postcode:2342CM
SEARCH_URL=https://www.marktplaats.nl/q/your-search-term/

# Optional: Friendly name for the items being monitored
ITEM_NAME=items

# Optional: Monitoring settings
CHECK_INTERVAL=60
MAX_PAGES=1

# Optional: Radius (km) used when SEARCH_URL has a postcode but no distance
DISTANCE_KM=50
