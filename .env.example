# Marktplaats Monitor — secrets only. Copy to .env (which is git-ignored).
# Everything else lives in config.yaml; reference these with env:NAME tokens.

# Apprise notification target(s). One or more URLs separated by commas or
# spaces. Examples:
#   discord://WEBHOOK_ID/WEBHOOK_TOKEN
#   tgram://BOT_TOKEN/CHAT_ID
#   ntfy://ntfy.sh/your-topic
#   mailto://user:pass@gmail.com
# See https://github.com/caronc/apprise for every supported service.
APPRISE_URLS=discord://WEBHOOK_ID/WEBHOOK_TOKEN

# Only needed if a search uses notify.backend: discord_native
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Optional outbound proxy for the scraper (referenced as env:HTTP_PROXY)
# HTTP_PROXY=http://user:pass@host:port
